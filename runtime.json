{
  "version": 2,
  "paths_registry": "paths.json",
  "workspace_root": "${UPWORK_ROOT}",
  "timezone": "Europe/Istanbul",
  "user_default_locale": "ru",
  "daily_root": "${UPWORK_DAILY_REL}",
  "registration": {
    "targets": [
      "antigravity",
      "codex"
    ]
  },
  "platforms": {
    "antigravity": {
      "enabled": true,
      "label": "Antigravity (A)",
      "surface": "antigravity-ui",
      "adapter": "antigravity",
      "capabilities": [
        "upwork_registration",
        "cleanup",
        "native_profiles",
        "roles",
        "executor_metadata",
        "review_proof",
        "trace_audit",
        "handoff"
      ],
      "handoff": {
        "conversation_trace_relative": "brain/<conversation_id>/.system_generated/logs/transcript_full.jsonl",
        "conversation_compact_trace_relative": "brain/<conversation_id>/.system_generated/logs/transcript.jsonl",
        "conversation_summary_db": "conversation_summaries.db",
        "conversation_db_relative": "conversations/<conversation_id>.db",
        "notes": "Each instance has isolated home, user_data_dir, config_dir, projects_dir, backend_dir, brain_dir, and logs_dir derived via paths.json platform_layouts.antigravity; all instances share folders_json."
      },
      "instances_source": "addons_profiles_json",
      "instance_overrides": {
        "A0": {
          "label": "Antigravity A0 (Default)"
        }
      },
      "subagents": {
        "selection": "parent",
        "fallback": "inherit",
        "record_decision": true
      },
      "roles": {
        "AA": {
          "selection": "parent",
          "agent": "self"
        },
        "AF": {
          "selection": "parent",
          "agent": "af-worker"
        },
        "ARCH": {
          "selection": "parent",
          "agent": "arch-auditor"
        }
      },
      "delegation": {
        "tool": "invoke_subagent",
        "complex_agent": "self",
        "simple_agent": "af-worker"
      },
      "folders_json": "${ANTIGRAVITY_ADDONS_CODE}/Folders/folders.json",
      "addons_profiles_json": "${ANTIGRAVITY_ADDONS_CODE}/Multi-Account/profiles.json",
      "addons": {
        "code_dir": "${ANTIGRAVITY_ADDONS_CODE}"
      },
      "browser": {
        "cdp_port": 9222,
        "owned_window_bounds": null,
        "primary_session_id": "chrome-default",
        "headless_shell": "${CHROME_HEADLESS_SHELL}"
      }
    },
    "codex": {
      "enabled": true,
      "label": "OpenAI Codex Desktop (C)",
      "surface": "codex-ui",
      "adapter": "codex",
      "capabilities": [
        "upwork_registration",
        "cleanup",
        "native_profiles",
        "roles",
        "executor_metadata",
        "review_proof",
        "trace_audit",
        "handoff"
      ],
      "registration_profile": "C2",
      "handoff": {
        "session_trace_relative": "sessions/**/*.jsonl",
        "state_db_glob": "state_*.sqlite",
        "notes": "Instances C1 and C2 are temporarily disabled due to lapsed subscription; local state and session logs remain readable for efficiency audits."
      },
      "subagents": {
        "selection": "parent",
        "fallback": "inherit",
        "record_decision": true
      },
      "roles": {
        "AA": {
          "selection": "parent",
          "agent": "upwork-aa"
        },
        "AF": {
          "selection": "parent",
          "agent": "upwork-af"
        },
        "ARCH": {
          "selection": "parent",
          "agent": "arch-auditor"
        }
      },
      "delegation": {
        "tool": "collaboration.spawn_agent",
        "complex_agent": "upwork-aa",
        "simple_agent": "upwork-af"
      },
      "instances": {
        "C1": {
          "enabled": false,
          "label": "Codex C1",
          "disabled_reason": "OpenAI subscription temporarily lapsed",
          "home": "${USER_HOME}/.codex"
        },
        "C2": {
          "enabled": false,
          "default_registration": true,
          "label": "Codex C2 (Registration)",
          "disabled_reason": "OpenAI subscription temporarily lapsed",
          "home": "${APPDATA}/Codex-Profile2"
        }
      },
      "node": "${NODE_EXE}",
      "ui_manage": "${CHATGPT_ADDONS_CODE}/UI/manage.mjs",
      "browser": {
        "cdp_port": 9222,
        "owned_window_bounds": null,
        "primary_session_id": "chrome-default",
        "headless_shell": "${CHROME_HEADLESS_SHELL}"
      }
    }
  },
  "text": {
    "browser": {
      "node": "${NODE_EXE}",
      "primary_session_id": "chrome-default",
      "headless_shell": {
        "executable": "${CHROME_HEADLESS_SHELL}",
        "fallback_glob": "${CHROME_HEADLESS_GLOB}"
      },
      "sessions": {
        "chrome-default": {
          "surface": "browser",
          "devtools_active_port": "${CHROME_PROFILE_DIR}/DevToolsActivePort",
          "fallback_endpoint": "http://127.0.0.1:9222",
          "profile": {
            "path": "${CHROME_PROFILE_DIR}",
            "argument": "--user-data-dir",
            "profile_directory": "Default",
            "extension_id": "ijadacmfoiadhndncikfnnpcmhkfdbhf",
            "extension_path": "${HARNESS_BROWSER_EXT_DIR}",
            "sentinel_origin": "https://harness-profile.invalid",
            "sentinel_cookie_name": "__harness_primary_profile"
          },
          "target_url_patterns": [
            "https://*",
            "http://*"
          ],
          "allowed_operations": [
            "read",
            "screenshot",
            "create",
            "navigate",
            "write",
            "close"
          ]
        }
      }
    }
  },
  "client_text": {
    "bash": "${CYGWIN_BASH}"
  }
}
